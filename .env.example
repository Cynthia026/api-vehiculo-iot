# --- Amazon RDS (MySQL) ---
DB_HOST=tu-endpoint-de-rds.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=vehiculo_iot

# --- Servidor ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Seguridad (OBLIGATORIO en producción) ---
# Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Contraseñas de las cuentas de demostración (opcional) ---
# Si defines una, la cuenta se crea o su contraseña se ROTA al reiniciar la API.
# Si no la defines, nunca se sobrescribe una contraseña existente.
SEED_ADMIN_PASSWORD=
SEED_CYNTHIA_PASSWORD=
SEED_CARLOS_PASSWORD=
SEED_INVITADO_PASSWORD=
